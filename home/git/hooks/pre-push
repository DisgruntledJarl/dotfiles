#!/bin/sh

# Get the name of the current branch
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# Check if we are on the forbidden branch
if [ "$current_branch" = "architecture" ]; then
    echo "====================================================="
    echo "❌ PUSH BLOCKED: You are on the 'architecture' branch."
    echo "Direct pushes to this branch are forbidden by hook."
    echo "====================================================="
    exit 1
fi

# Allow the push for all other branches
exit 0
