{
    "permissions": {
        "defaultMode": "auto",
        "allow": [
            "Read(*)",
            "Glob(*)",
            "Grep(*)",
            "Write(*)",
            "Bash(git status)",
            "Bash(git add *)",
            "Bash(npm test)",
            "Bash(ls *)",
            "Bash(grep *)"
        ],
        "deny": ["Bash(rm -rf *)", "Bash(git push *)"]
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh",
        "refreshInterval": 30
    },
    "effortLevel": "medium",
    "skipDangerousModePermissionPrompt": true,
    "theme": "dark"
}
